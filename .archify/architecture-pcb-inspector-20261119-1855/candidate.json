    { "kind": "region", "label": "Local machine — fully offline", "wraps": ["operator", "spa", "api", "db", "cv_detect", "demo"], "pad": 20 }
  ],
  "connections": [
    { "from": "operator", "to": "spa", "label": "opens http://localhost:8000", "variant": "emphasis" },
    { "from": "spa", "to": "api", "label": "REST: uploads, annotations, inspection, export", "variant": "emphasis" },
    { "from": "api", "to": "db", "label": "SQLite: images, annotations, inspections", "variant": "solid" },
